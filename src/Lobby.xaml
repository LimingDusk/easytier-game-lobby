<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:GameLobby" x:Class="GameLobby.Lobby" Title="联机大厅" Width="1050" Height="690" MinWidth="760" MinHeight="550" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}" FontSize="14" FontFamily="Microsoft YaHei UI, Segoe UI" Icon="Assets/GameLobby.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="50" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Light.xaml"/>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid x:Name="frame">
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>
        <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Rule}" Padding="26,0,0,0">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal">
                    <ui:Glyph Kind="logo" Width="24" Height="24"/>
                    <TextBlock Text="联机大厅" FontSize="16" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="minimize" Style="{StaticResource Quiet}" Width="46" Padding="0" VerticalAlignment="Stretch" AutomationProperties.Name="最小化" ToolTip="最小化">
                        <StackPanel Orientation="Horizontal">
                            <ui:Glyph Kind="minimize" Width="14" Height="14"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="maximize" Style="{StaticResource Quiet}" Width="46" Padding="0" VerticalAlignment="Stretch" AutomationProperties.Name="最大化或还原" ToolTip="最大化或还原">
                        <StackPanel Orientation="Horizontal">
                            <ui:Glyph x:Name="maximizeGlyph" Kind="maximize" Width="14" Height="14"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="closeWindow" Style="{StaticResource Quiet}" Width="46" Padding="0" VerticalAlignment="Stretch" AutomationProperties.Name="关闭" ToolTip="关闭">
                        <StackPanel Orientation="Horizontal">
                            <ui:Glyph Kind="close" Width="14" Height="14"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid x:Name="mainPage" Grid.Row="1" Margin="32,16,32,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="游戏模块" Style="{StaticResource Secondary}" FontWeight="SemiBold"/>
                <DockPanel Margin="0,7,0,0" LastChildFill="False">
                    <Button x:Name="games" Width="230" Height="46" HorizontalContentAlignment="Stretch" AutomationProperties.Name="切换游戏模块">
                        <Grid Width="198">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:Glyph Kind="game" Foreground="{DynamicResource Accent}"/>
                            <TextBlock x:Name="gameName" Grid.Column="1" FontSize="20" Margin="14,0" FontWeight="SemiBold"/>
                            <ui:Glyph Kind="chevron" Width="13" Height="13" Grid.Column="2"/>
                        </Grid>
                    </Button>
                    <TextBlock x:Name="roomState" Text="●  未加入房间" Margin="24,0,0,0" Style="{StaticResource Secondary}" FontWeight="SemiBold"/>
                    <Button x:Name="leave" DockPanel.Dock="Right" VerticalAlignment="Center" AutomationProperties.Name="离开房间" ToolTip="离开房间">
                        <StackPanel Orientation="Horizontal">
                            <ui:Glyph Kind="leave" Width="16" Height="16"/>
                            <TextBlock Text="离开房间" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </DockPanel>
            </StackPanel>
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,12" Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MaxWidth="300"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="0.7*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="房间邀请码" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,0"/>
                    <Border Grid.Column="1" MaxWidth="320" HorizontalAlignment="Stretch" CornerRadius="7" Background="{DynamicResource Field}">
                        <DockPanel>
                            <Button x:Name="eye" Style="{StaticResource Quiet}" DockPanel.Dock="Right" Width="34" Padding="0" AutomationProperties.Name="显示邀请码" ToolTip="显示邀请码">
                                <StackPanel Orientation="Horizontal">
                                    <ui:Glyph Kind="eye" Width="16" Height="16"/>
                                </StackPanel>
                            </Button>
                            <Grid>
                                <TextBox x:Name="invite" AutomationProperties.Name="房间邀请码" Height="38" FontSize="14"/>
                                <TextBlock x:Name="inviteHint" Text="粘贴好友发来的邀请码" IsHitTestVisible="False" Margin="12,0,0,0" Style="{StaticResource Secondary}"/>
                            </Grid>
                        </DockPanel>
                    </Border>
                    <Button x:Name="join" Grid.Column="2" Margin="12,0,0,0" AutomationProperties.Name="加入房间" ToolTip="加入房间">
                        <StackPanel Orientation="Horizontal">
                            <ui:Glyph Kind="join" Width="16" Height="16"/>
                            <TextBlock Text="加入房间" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="copy" Style="{StaticResource Primary}" Grid.Column="3" Margin="12,0,0,0" AutomationProperties.Name="复制邀请码" ToolTip="复制邀请码">
                        <StackPanel Orientation="Horizontal">
                            <ui:Glyph Kind="copy" Width="16" Height="16"/>
                            <TextBlock Text="复制邀请码" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="host" Style="{StaticResource Primary}" Grid.Column="5" AutomationProperties.Name="创建房间" ToolTip="创建房间">
                        <StackPanel Orientation="Horizontal">
                            <ui:Glyph Kind="plus" Width="16" Height="16"/>
                            <TextBlock Text="创建房间" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="49"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="22,0" LastChildFill="False">
                        <TextBlock Text="房间成员" Style="{StaticResource Heading}"/>
                        <Border Background="{DynamicResource Tint}" CornerRadius="14" Padding="12,3" VerticalAlignment="Center" Margin="14,0">
                            <TextBlock x:Name="countBadge" Text="0 人" Foreground="{DynamicResource Accent}" FontSize="13" FontWeight="SemiBold"/>
                        </Border>
                        <Button x:Name="inspect" Style="{StaticResource Quiet}" DockPanel.Dock="Right" VerticalAlignment="Center" AutomationProperties.Name="刷新" ToolTip="刷新">
                            <StackPanel Orientation="Horizontal">
                                <ui:Glyph Kind="refresh" Width="14" Height="14"/>
                                <TextBlock Text="刷新" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </DockPanel>
                    <ui:PeerTable x:Name="members" Grid.Row="1" Margin="0,0,0,6" AutomationProperties.Name="房间成员"/>
                    <StackPanel x:Name="emptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12,0,12,16">
                        <Border Width="82" Height="82" CornerRadius="24" Background="{DynamicResource Tint}" HorizontalAlignment="Center">
                            <ui:Glyph Kind="people" Width="38" Height="38" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="emptyTitle" Text="等待加入房间" Style="{StaticResource Heading}" HorizontalAlignment="Center" Margin="0,16,0,10"/>
                        <TextBlock x:Name="memberStatus" Style="{StaticResource Secondary}" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <Border x:Name="guideBar" Grid.Row="2" Padding="0,10" Margin="22,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Rule}">
                        <DockPanel>
                            <ui:Glyph Kind="book" Width="14" Height="14" Foreground="{DynamicResource Muted}"/>
                            <TextBlock x:Name="guideTitle" Style="{StaticResource Secondary}" FontWeight="SemiBold" Margin="9,0,18,0"/>
                            <TextBlock x:Name="guide" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="diagnosticsPage" Grid.Row="1" Margin="32,16,32,14" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel LastChildFill="False" Margin="0,0,0,14">
                <TextBlock Text="网络诊断" Style="{StaticResource Heading}" FontSize="25"/>
                <Button x:Name="export" DockPanel.Dock="Right" AutomationProperties.Name="导出日志" ToolTip="导出日志">
                    <StackPanel Orientation="Horizontal">
                        <ui:Glyph Kind="export" Width="16" Height="16"/>
                        <TextBlock Text="导出日志" Margin="7,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </DockPanel>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="22,16">
                <DockPanel>
                    <TextBlock Text="自定义引导节点" Width="178" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <Grid>
                        <TextBox x:Name="bootstrap" MinHeight="40" FontFamily="Consolas" AutomationProperties.Name="自定义引导节点"/>
                        <TextBlock x:Name="bootstrapHint" Style="{StaticResource Secondary}" FontFamily="Consolas" Margin="12,0" IsHitTestVisible="False"/>
                    </Grid>
                </DockPanel>
            </Border>
            <Grid Grid.Row="2" Margin="0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="20,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:Glyph Kind="link" Foreground="{DynamicResource Accent}"/>
                            <TextBlock Text="引导连接" Margin="8,0" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock x:Name="connectorSummary" TextWrapping="Wrap" MaxHeight="56" TextTrimming="CharacterEllipsis" Margin="0,13,0,0" Style="{StaticResource Secondary}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:Glyph Kind="pulse" Foreground="{DynamicResource Accent}"/>
                            <TextBlock Text="广播中继" Margin="8,0" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock x:Name="broadcastSummary" Style="{StaticResource Secondary}" Margin="0,13,0,0" TextTrimming="CharacterEllipsis"/>
                        <UniformGrid x:Name="broadcastGrid" Columns="3" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock x:Name="captured" Text="—" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Text="已捕获" Style="{StaticResource Secondary}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="forwarded" Text="—" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Text="已转发" Style="{StaticResource Secondary}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="failed" Text="—" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Text="转发失败" Style="{StaticResource Secondary}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>
            <Border Grid.Row="3" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="节点详情" Style="{StaticResource Heading}" Margin="22,0"/>
                    <ui:PeerTable x:Name="diagnosticNodes" Diagnostic="True" Grid.Row="1" AutomationProperties.Name="节点详情"/>
                    <TextBlock x:Name="peerNotice" Grid.Row="1" Margin="22,6" TextWrapping="Wrap" Style="{StaticResource Secondary}"/>
                    <TextBlock x:Name="localAddress" Grid.Row="2" Style="{StaticResource Secondary}" Margin="22,4"/>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Rule}" Padding="30,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Border CornerRadius="20" VerticalAlignment="Center" Background="{DynamicResource Field}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" Padding="3">
                        <StackPanel x:Name="modeBar" Orientation="Horizontal">
                            <RadioButton x:Name="systemMode" Style="{StaticResource Mode}" GroupName="Appearance" ToolTip="跟随系统" AutomationProperties.Name="跟随系统">
                                <ui:Glyph Kind="monitor"/>
                            </RadioButton>
                            <RadioButton x:Name="lightMode" Style="{StaticResource Mode}" GroupName="Appearance" ToolTip="浅色" AutomationProperties.Name="浅色">
                                <ui:Glyph Kind="sun"/>
                            </RadioButton>
                            <RadioButton x:Name="darkMode" Style="{StaticResource Mode}" GroupName="Appearance" ToolTip="深色" AutomationProperties.Name="深色">
                                <ui:Glyph Kind="moon"/>
                            </RadioButton>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource Edge}" Width="1" Height="20" Margin="16,0,4,0"/>
                    <Button x:Name="togglePage" Style="{StaticResource Quiet}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <ui:Glyph x:Name="pageIcon" Kind="pulse"/>
                            <TextBlock x:Name="pageLabel" Text="网络诊断" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <ui:Glyph x:Name="statusIcon" Kind="people" Width="16" Height="16" Foreground="{DynamicResource Muted}"/>
                <TextBlock x:Name="status" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" Margin="10,0"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
