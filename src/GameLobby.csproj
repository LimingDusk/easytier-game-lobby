<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets/GameLobby.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.4.2</Version>
    <EngineArchiveSha256>27af91e270e554709b048bd32327fefd2dfce5062ae1e8701af7550c6f525f84</EngineArchiveSha256>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyName>GameLobby</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/GameLobby.ico" />
    <EmbeddedResource Include="Assets/Octicons.LICENSE.txt" />
    <Using Include="System.IO" />
    <InternalsVisibleTo Include="WindowChecks" />
    <Compile Include="$(IntermediateOutputPath)SvgPaths.g.cs;$(IntermediateOutputPath)Brand.g.cs" />
  </ItemGroup>
  <Target Name="GenerateSvgPaths" BeforeTargets="MarkupCompilePass1;CoreCompile"
          Inputs="Assets/LobbyIcons.svg;Assets/GameLobby.svg;Assets/SvgPaths.xsl" Outputs="$(IntermediateOutputPath)SvgPaths.g.cs;$(IntermediateOutputPath)Brand.g.cs">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <XslTransformation XmlInputPaths="Assets/LobbyIcons.svg;Assets/GameLobby.svg" XslInputPath="Assets/SvgPaths.xsl"
                       OutputPaths="$(IntermediateOutputPath)SvgPaths.g.cs;$(IntermediateOutputPath)Brand.g.cs" />
  </Target>
  <ItemGroup Condition="'$(EngineArchive)' != ''">
    <!-- Changing between the preview and bundled builds must invalidate the compiler cache. -->
    <CoreCompileCache Include="$(EngineArchive)" />
    <EmbeddedResource Include="$(EngineArchive)" LogicalName="GameLobby.EasyTier.zip" />
    <AssemblyMetadata Include="EngineArchiveSha256" Value="$(EngineArchiveSha256)" />
  </ItemGroup>
  <Target Name="VerifyEngineArchive" BeforeTargets="PrepareForBuild" Condition="'$(EngineArchive)' != ''">
    <GetFileHash Files="$(EngineArchive)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="EngineHash" />
    </GetFileHash>
    <Error Condition="'$(EngineHash)' != '$(EngineArchiveSha256)'" Text="Unexpected EasyTier archive digest." />
  </Target>
</Project>
